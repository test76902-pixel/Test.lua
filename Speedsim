    CurrentValue = _G.autoCycleChests,
    Flag = "Chests",
    Callback = function(v) _G.autoCycleChests = v end,
})

-- Auto Rebirth Toggle
Tab:CreateToggle({
    Name = "Auto Rebirth (50 + 25×R)",
    CurrentValue = _G.autoRebirth,
    Flag = "AutoRebirth",
    Callback = function(v) _G.autoRebirth = v end,
})

-- MANUAL REBIRTH BUTTON
Tab:CreateButton({
    Name = "MANUAL REBIRTH NOW",
    Callback = function()
        manualRebirth()
    end,
})

