--// GUI CONTROLS
Tab:CreateToggle({
    Name = "ULTRA Hoops (1000+ TPS)",
    CurrentValue = _G.autoCycleHoops,
    Flag = "UltraHoops",
    Callback = function(v)
        _G.autoCycleHoops = v
        if v then refreshHoops() end
        Rayfield:Notify({Title = v and "Hoops ON" or "Hoops OFF", Duration = 2})
    end,
})

Tab:CreateToggle({
    Name = "Random Chest (1/sec)",
    CurrentValue = _G.autoCycleChests,
    Flag = "Chests",
    Callback = function(v)
        _G.autoCycleChests = v
        Rayfield:Notify({Title = v and "Chests ON" or "Chests OFF", Duration = 2})
    end,
})

Tab:CreateToggle({
    Name = "AUTO REBIRTH (player.level)",
    CurrentValue = _G.autoRebirth,
    Flag = "AutoRebirth",
    Callback = function(v)
        _G.autoRebirth = v
        Rayfield:Notify({Title = v and "AUTO REBIRTH ON" or "AUTO REBIRTH OFF", Duration = 3})
    end,
})

Tab:CreateToggle({
    Name = "INFINITE AUTO WIN RACE",
    CurrentValue = _G.autoWinRace,
    Flag = "AutoWinRace",
    Callback = function(v)
        _G.autoWinRace = v
        RaceTimerLabel:Set(v and "Race Timer: Loading..." or "Race Timer: OFF")
        Rayfield:Notify({
            Title = v and "INFINITE RACE WIN ON" or "RACE WIN OFF",
            Content = v and "Desert→Grass→Magma→LOOP FOREVER!" or "",
            Duration = 4
        })
    end,
})

Tab:CreateButton({
    Name = "MANUAL REBIRTH NOW",
    Callback = manualRebirth,
})

Tab:CreateButton({
    Name = "JOIN RACE NOW",
    Callback = function()
        pcall(function()
            raceEvent:FireServer("joinRace")
            Rayfield:Notify({Title="Race Joined!", Content="Manual join!", Duration=2})
        end)
    end,
})

