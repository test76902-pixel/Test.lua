--// ULTIMATE FARM + INFINITE RACE WIN + LIVE GUI TIMER
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "ULTIMATE FARM + RACE WINNER",
    LoadingTitle = "Loading…",
    LoadingSubtitle = "Hoops • Chests • Rebirth • LIVE TIMER",
    ConfigurationSaving = {Enabled = true, FolderName = "UltimateFarmV3"}
})
local Tab = Window:CreateTab("Features")

--// Global Toggles
_G.autoCycleHoops  = _G.autoCycleHoops  or false
_G.autoCycleChests = _G.autoCycleChests or false
_G.autoRebirth     = _G.autoRebirth     or false
_G.autoWinRace     = _G.autoWinRace     or false

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart", 10)
end

--------------------------------------------------------------------
--// 1. ULTRA HOOPS (1000+ TPS)
local lastHoopIndex = 0
local hoopsList = {}
local lastCacheTime = 0

local function refreshHoops()
    local folder = workspace:FindFirstChild("Hoops")
    if not folder then return end
    hoopsList = {}
    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Name == "Hoop" and obj:IsA("MeshPart") then
            table.insert(hoopsList, obj)
        end
    end
    lastCacheTime = tick()
end
refreshHoops()

RunService.Heartbeat:Connect(function()
    if not _G.autoCycleHoops then return end
    local hrp = getHRP()
    if not hrp or #hoopsList == 0 then return end
    if tick() - lastCacheTime > 5 then refreshHoops() end
    lastHoopIndex = (lastHoopIndex % #hoopsList) + 1
    local target = hoopsList[lastHoopIndex]
    hrp.CFrame = target.CFrame + Vector3.new(0, 5, 0)
end)

--------------------------------------------------------------------
--// 2. RANDOM CHEST (1/sec)
task.spawn(function()
    while task.wait(1) do
        if _G.autoCycleChests then
            pcall(function()
                local hrp = getHRP()
                if not hrp then return end
                local container = workspace:FindFirstChild("rewardChests")
                if not container then return end
                local parts = {}
                for _, v in ipairs(container:GetChildren()) do
                    if v:IsA("BasePart") then table.insert(parts, v) end
                end
                if #parts > 0 then
                    local chosen = parts[math.random(1, #parts)]
                    hrp.CFrame = chosen.CFrame + Vector3.new(0, 5, 0)
                end
            end)
        end
    end
end)

--------------------------------------------------------------------
--// 3. AUTO REBIRTH (uses player.level)
local rebirthEvent = nil
local function locateRebirthEvent()
    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    if rEvents then
        rebirthEvent = rEvents:FindFirstChild("rebirthEvent")
    end
end
locateRebirthEvent()
task.spawn(function() while task.wait(3) do locateRebirthEvent() end end)
player.CharacterAdded:Connect(locateRebirthEvent)

local function manualRebirth()
    if rebirthEvent then
        rebirthEvent:FireServer("rebirthRequest")
        Rayfield:Notify({Title="Manual Rebirth!", Content="Fired!", Duration=3})
    else
        Rayfield:Notify({Title="Error", Content="No rebirthEvent!", Duration=4})
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if not _G.autoRebirth then continue end
        pcall(function()
            local levelVal = player:FindFirstChild("level")
            local leaderstats = player:FindFirstChild("leaderstats")
            local rebirthsVal = leaderstats and leaderstats:FindFirstChild("Rebirths")
            if not levelVal or not rebirthsVal then return end
            local level = levelVal.Value
            local rebirths = rebirthsVal.Value
            local required = 50 + (rebirths * 25)
            if level >= required and rebirthEvent then
                rebirthEvent:FireServer("rebirthRequest")
                Rayfield:Notify({
                    Title = "AUTO REBIRTH!",
                    Content = string.format("Level %d ≥ %d", level, required),
                    Duration = 5
                })
            end
        end)
    end
end)

--------------------------------------------------------------------
--// 4. INFINITE RACE WIN + LIVE GUI TIMER
local raceEvent = ReplicatedStorage.rEvents:WaitForChild("raceEvent")
local raceTimer = ReplicatedStorage:WaitForChild("raceTimer")
local raceStarted = ReplicatedStorage:WaitForChild("raceStarted")

-- Cache finish parts
local finishParts = {}
pcall(function()
    finishParts[1] = workspace.raceMaps.Desert.finishPart
    finishParts[2] = workspace.raceMaps.Grassland.finishPart
    finishParts[3] = workspace.raceMaps.Magma.finishPart
end)

local raceFinishIndex = 1
local raceTeleportConnection = nil

-- Auto join when timer = 0
task.spawn(function()
    while task.wait(0.1) do
        if _G.autoWinRace and raceTimer.Value == 0 then
            pcall(function()
                raceEvent:FireServer("joinRace")
                task.wait(0.5)
            end)
        end
    end
end)

-- Infinite teleport loop during race
raceStarted.Changed:Connect(function()
    if not _G.autoWinRace then return end
    if raceStarted.Value == true then
        _G.autoCycleHoops = false
        if raceTeleportConnection then raceTeleportConnection:Disconnect() end
        raceTeleportConnection = RunService.Heartbeat:Connect(function()
            if raceStarted.Value == false then
                raceTeleportConnection:Disconnect()
                _G.autoCycleHoops = true
                return
            end
            local hrp = getHRP()
            if hrp and #finishParts > 0 then
                local part = finishParts[raceFinishIndex]
                if part and part.Parent then
                    hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                end
                raceFinishIndex = (raceFinishIndex % 3) + 1
            end
        end)
    end
end)

-- LIVE RACE TIMER IN GUI (no notifications!)
local RaceTimerLabel = Tab:CreateLabel("Race Timer: OFF")

task.spawn(function()
    while task.wait(1) do
        if _G.autoWinRace then
            local timeLeft = raceTimer.Value
            local text = timeLeft > 0 and string.format("Race Timer: %d sec", timeLeft) or "Race Timer: READY!"
            RaceTimerLabel:Set(text)
        else
            RaceTimerLabel:Set("Race Timer: OFF")
        end
    end
end)

